FROM docker.io/arm64v8/ubuntu:jammy

LABEL maintainer="NCSU SCRC special_collections@ncsu.edu"

# Prevent interactive prompts during package installation
ARG DEBIAN_FRONTEND=noninteractive

# Define user args
ARG USERNAME=user
ARG GROUPNAME=scrc
ARG USER_UID=1000
ARG USER_GID=2000

RUN apt-get update \
    && apt-get install -y \
    build-essential \
    ca-certificates \
    clamav \
    clamav-daemon \
    curl \
    default-jre \
    disktype \
    dvd+rw-tools \
    fdisk \
    git \
    libimage-exiftool-perl \
    mediainfo \
    nfs-common \
    python3 \
    python3-pip \
    sleuthkit \
    software-properties-common \
    sudo \
    tree \
    unzip \
    wget \
# Clean up the apt cache
    && rm -rf /var/lib/apt/lists/* \
# Users, group, and sudo access
    && groupadd --gid $USER_GID $GROUPNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && echo $USERNAME ALL=\(ALL\) NOPASSWD: /bin/apt-get -y update, /bin/apt-get -y upgrade, /bin/freshclam, /usr/local/bin/update_env.sh > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME \
# Install bulk_extractor
    && mkdir /home/repos \
    && cd /home/repos \
    && git clone --recursive https://github.com/simsong/bulk_extractor.git \
    && cd bulk_extractor && bash etc/CONFIGURE_UBUNTU22LTS.bash \
    && bash bootstrap.sh \
    && ./configure \
    && make \
    && make install \
    && rm -r /home/repos/bulk_extractor \
# Install hfsexplorer
    && mkdir /usr/share/hfsexplorer \
    && cd /usr/share/hfsexplorer \
    && wget https://sourceforge.net/projects/catacombae/files/HFSExplorer/0.23.1%20%28snapshot%202016-09-02%29/hfsexplorer-0.23.1-snapshot_2016-09-02-bin.zip \
    && unzip hfsexplorer-0.23.1-snapshot_2016-09-02-bin.zip \
    && rm hfsexplorer-0.23.1-snapshot_2016-09-02-bin.zip \
# Install brunnhilde
    && python3 -m pip install brunnhilde \
# Install walk_to_dfxml
    && cd /home/repos \
    && git clone https://github.com/dfxml-working-group/dfxml_python.git \
    && cd dfxml_python \
    && pip3 install . \
    && cd /home \
    && rm -r /home/repos/dfxml_python \
# Install isolyzer
    && python3 -m pip install isolyzer \
# Install go v1.24 for ARM64
    && curl -fL -o go.tar.gz https://go.dev/dl/go1.24.0.linux-arm64.tar.gz \
    && tar -C /usr/local -xzf go.tar.gz \
    && rm go.tar.gz

# Add go to system-wide PATH
ENV PATH="/usr/local/go/bin:${PATH}"

# Install siegfried v1.11.4
# Set GOBIN to /usr/local/bin so sf is available to all users
RUN GOBIN=/usr/local/bin go install github.com/richardlehane/siegfried/cmd/sf@v1.11.4

# Copy script and set permissions    
COPY --chmod=0775 --chown=1000:2000 ./update_env_ubu.sh /usr/local/bin/
# Defines the command run each time container starts, in this case a bash script that updates environment and packages
ENTRYPOINT ["update_env_ubu.sh"]
CMD ["/bin/bash"]